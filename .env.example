# Base de datos (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://user:password@localhost:5432/inmobiliaria

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Almacenamiento de media (Cloudflare R2 o S3)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=

# Typesense
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=
TYPESENSE_PROTOCOL=http

# BullMQ / Redis
REDIS_URL=redis://localhost:6379

# Email (Resend o Postmark)
EMAIL_API_KEY=
EMAIL_FROM=no-reply@tudominio.com

# WhatsApp (número de la inmobiliaria)
WHATSAPP_PHONE=598XXXXXXXXX

# CRM externo (Pipedrive o HubSpot)
CRM_API_KEY=
CRM_PROVIDER=pipedrive

# Cifrado de datos sensibles (propietarios)
ENCRYPTION_KEY=

# Sentry
SENTRY_DSN=
